# === Credentials ===
BOT_TOKEN=your_bot_token_here
OPENROUTER_API_KEY=your_openrouter_key_here
TARGET_CHANNEL_ID=-1001234567890

# === Модели (порядок = fallback) ===
MODEL_LIST=google/gemini-2.5-flash,qwen/qwen-2.5-vl-72b-instruct

# === Промо-слайд ===
PROMO_IMAGE_PATH=assets/promo_final.jpg
PROMO_CAPTION=🏁 HoopLabs — больше баскетбольных дрилов!

# === Производительность ===
MAX_PARALLEL=4
MAX_DOWNLOADS=4
MAX_ATTEMPTS_PER_MODEL=2
REQUEST_TIMEOUT=120.0
TIKWM_TIMEOUT=30.0
TIKWM_MAX_RETRIES=3
CAPTION_LIMIT=950

# === Бюджет OpenRouter (центов в день) ===
DAILY_BUDGET_CENTS=50